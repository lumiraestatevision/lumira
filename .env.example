# =============================================================================
# Lumira – lokale Konfiguration
# Kopieren nach .env (macht `make setup` automatisch) und bei Bedarf anpassen.
# .env ist in .gitignore – echte Schlüssel landen nie im Repo.
# Alle Werte hier sind reine Entwicklungswerte, NICHT für Staging/Produktion.
# =============================================================================

# ----------------------------------------------------------------- Docker Compose
# Welche optionalen Services starten. Genau EINES von cpu/gpu, dazu optional vr und llm.
#   cpu  recognizer mit CPU-PyTorch – läuft auf jedem Rechner
#   gpu  recognizer mit CUDA – nur mit NVIDIA-GPU und NVIDIA Container Toolkit
#   vr   Unreal-Stub (dann auch PIPELINE_VR_ENABLED=true setzen)
#   llm  lokales LLM (Ollama) für blv – dann BLV_PROVIDER=ollama; NVIDIA-GPU nötig
COMPOSE_PROFILES=cpu

# true  = Pipeline endet erst nach vr.exported (braucht Profil "vr")
# false = backend schließt Projekte direkt nach model.generated ab
PIPELINE_VR_ENABLED=false

# ----------------------------------------------------------------- Allgemein
ENVIRONMENT=local          # local | test | ci | staging | production
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false             # false = lesbare Logs in `make logs`, true = JSON (CI/Server)

# ----------------------------------------------------------------- PostgreSQL (backend)
POSTGRES_USER=lumira
POSTGRES_PASSWORD=lumira-dev-only
POSTGRES_DB=lumira
POSTGRES_PORT=5432         # Host-Port; ändern, falls lokal schon ein Postgres läuft
# Für Befehle direkt auf dem Host (z. B. `uv run alembic …`). In Containern setzt
# docker-compose.yml die URL selbst mit Hostname "postgres".
DATABASE_URL=postgresql+asyncpg://lumira:lumira-dev-only@localhost:5432/lumira

# ----------------------------------------------------------------- Redis (Event-Bus)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0   # nur für Host-Befehle; Container nutzen redis:6379

# Consumer-Verhalten aller Services
CONSUMER_CLAIM_IDLE_MS=30000   # nach so vielen ms wird ein fehlgeschlagenes Event erneut zugestellt
CONSUMER_MAX_ATTEMPTS=3        # danach: step.failed + Dead-Letter-Stream

# ----------------------------------------------------------------- MinIO (lokales S3)
MINIO_ROOT_USER=lumira
MINIO_ROOT_PASSWORD=lumira-dev-secret   # mindestens 8 Zeichen
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001                 # Web-Konsole: http://localhost:9001
S3_BUCKET=lumira
AWS_DEFAULT_REGION=eu-central-1
# Für Host-Befehle. Ist AWS_ENDPOINT_URL gesetzt, nutzt lumira_shared automatisch MinIO;
# ohne die Variable spräche derselbe Code mit echtem AWS S3.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=lumira
AWS_SECRET_ACCESS_KEY=lumira-dev-secret

# ----------------------------------------------------------------- backend
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------- blv (Leistungsverzeichnis per LLM)
# Ohne Key für den gewählten Anbieter = Stub-Modus mit Beispieldaten; die Kette läuft trotzdem.
# anthropic: Claude, Produktion | gemini: Google, NUR lokale Entwicklung
# ollama: lokales Modell, kostenlos, ohne Key (Profil llm) – nur Entwicklung/Tests
BLV_PROVIDER=anthropic
BLV_MODE=auto              # auto (LLM, wenn Key gesetzt bzw. ollama) | llm (Pflicht) | stub

# Anthropic – Key: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
BLV_MODEL=claude-opus-5    # günstigere Alternative: claude-sonnet-5
BLV_LLM_FALLBACKS=true     # server-seitiger Fallback bei Ablehnung (empfohlen für claude-opus-5)

# Google Gemini – Key: https://aistudio.google.com → "Get API key"
# Gratistarif: Google darf Ein-/Ausgaben lesen und nutzen → keine vertraulichen oder
# personenbezogenen Daten. Für Nutzer in EWR/CH/UK ist laut Bedingungen nur der Bezahltarif erlaubt.
GEMINI_API_KEY=
BLV_GEMINI_MODEL=gemini-3.8-flash
# Ausweichmodelle bei Überlastung (503) / Kontingent erschöpft (429) / nicht freigeschaltet (404)
BLV_GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Lokales Modell (Ollama, Profil llm) – kein Key, das PDF verlässt den Rechner nicht.
# Deutlich schwächer als Claude bei Varianten und Innen/Außen → für Kunden-LVs anthropic nutzen.
# Das Modell wird beim ersten `make up` heruntergeladen (einige GB).
BLV_OLLAMA_MODEL=qwen3.5:4b   # passt mit großem Kontext in 8 GB Grafikspeicher
BLV_OLLAMA_NUM_CTX=32768      # Kontextfenster (Tokens); kleiner = weniger Grafikspeicher, mehr Abschnitte
BLV_OLLAMA_THINK=false        # true = Modell "denkt nach": evtl. genauer, deutlich langsamer

# ----------------------------------------------------------------- generator (Blender)
BLENDER_VERSION=4.5.14     # Blender 4.5 LTS; Build-Argument des generator-Images
BLENDER_TIMEOUT_S=600

# ----------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----------------------------------------------------------------- Demo übers Internet (make demo)
# Cloudflare Quick Tunnel: öffentliche https-Adresse ohne Konto; sie ändert sich bei jedem Start.
# Jede Seite verlangt Benutzer + Passwort. Passwort: mind. 12 Zeichen, ohne Leerzeichen und ohne #.
DEMO_USER=lumira
DEMO_PASSWORD=
